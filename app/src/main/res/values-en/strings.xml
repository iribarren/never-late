    <string name="focus_abandon_confirm_title">Abandon session</string>
    <string name="focus_abandon_confirm_message">The session will be closed as abandoned. Are you sure you want to continue?</string>
    <string name="focus_abandon_confirm_button">Abandon</string>
    <string name="focus_abandon_cancel_button">Cancel</string>

    <!-- Focus Mode: the exit-outcome snackbar shown back on Tasks (D3), via the same
