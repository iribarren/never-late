    <!-- Tasks list screen -->
    <string name="tasks_title">Tasks</string>
    <!-- The action button on the empty state already invites the user to add a task (feature 17),
         so this message stays purely informational rather than repeating "Tap +". -->
    <string name="tasks_empty">You have no tasks yet.</string>
    <!-- editable-profile-name spec (D1/D7): shown instead of tasks_empty when a name is stored;
         falls back to the generic string when blank. -->
    <string name="tasks_empty_personalized">Nothing pending, %1$s.</string>
    <string name="tasks_empty_action">Add task</string>
    <string name="tasks_add_content_description">Add task</string>
    <!-- One-shot snackbar (feature 17), shown once after creating a task — see AppNavHost's
         create-only Task Edit wiring and TasksRoute's SavedStateHandle collection. -->
    <string name="tasks_task_created_snackbar">Task created.</string>
    <string name="tasks_back_content_description">Back</string>
    <string name="tasks_delete_content_description">Delete task</string>
    <string name="tasks_start_content_description">Start countdown</string>
    <string name="tasks_pause_content_description">Pause countdown</string>
    <string name="tasks_time_up">Time\'s up</string>
    <!-- Feature 20b: compact remaining-time countdown, assembled from locale-formatted numbers
         (%1$s/%2$s/%3$s) so translators control the unit letters and word order instead of the
         code concatenating them. Siblings of tasks_duration_* on purpose, not reused: a compact
         counter ("38m") and a prose duration ("38 min") want different abbreviations, and one
         should never change the other by accident. No <plurals> — abbreviated forms have no
         singular/plural variation. -->
    <string name="tasks_remaining_days_hours_minutes">%1$sd %2$sh %3$sm</string>
    <string name="tasks_remaining_hours_minutes">%1$sh %2$sm</string>
    <string name="tasks_remaining_hours">%1$sh</string>
    <string name="tasks_remaining_minutes">%1$sm</string>
    <string name="tasks_remaining_under_minute">&lt;1m</string>
    <!-- Feature 19: accessibility state description for the determinate progress bar, announced by
         screen readers alongside the bar's own built-in progress semantics. %1$s is a locale-formatted
         percentage (e.g. "45%"), not concatenated in code. -->
    <string name="tasks_progress_state_description">%1$s elapsed</string>
    <string name="tasks_duration_label">Duration: %1$s</string>
    <!-- Duration pieces, assembled from locale-formatted numbers (%1$s/%2$s) so translators
         control the unit abbreviations and word order instead of the code concatenating them. -->
    <string name="tasks_duration_hours_minutes">%1$sh %2$smin</string>
    <string name="tasks_duration_hours">%1$sh</string>
    <string name="tasks_duration_minutes">%1$smin</string>
    <string name="tasks_deadline_label">Deadline: %1$s</string>
    <string name="tasks_delete_confirm_title">Delete task</string>
    <string name="tasks_delete_confirm_message">Delete “%1$s”?</string>
    <string name="tasks_delete_confirm_button">Delete</string>
    <string name="tasks_delete_cancel_button">Cancel</string>

    <!-- Feature 03b: in-memory filter/sort/group controls, above the list. -->
    <string name="tasks_filter_label">Search by title</string>
    <!-- Feature 04b: trailing "clear" (✕) icon on the search field, shown only while it has text. -->
    <string name="tasks_filter_clear_content_description">Clear search</string>
    <string name="tasks_sort_deadline">Deadline</string>
    <string name="tasks_sort_title">Title</string>
    <!-- Feature priority-sorting (US-1): third sort field. -->
    <string name="tasks_sort_priority">Priority</string>
    <string name="tasks_sort_direction_ascending">Ascending order</string>
    <string name="tasks_sort_direction_descending">Descending order</string>
    <string name="tasks_group_by_urgency">Group by urgency</string>
    <!-- Feature priority-sorting (US-3): second, independently-toggleable grouping chip. -->
    <string name="tasks_group_by_priority">Group by priority</string>
    <!-- Section headers, shown only while grouping is active, in this fixed order (most urgent
         first) regardless of UrgencyLevel's own declaration order. -->
    <string name="tasks_section_overdue">Overdue</string>
    <string name="tasks_section_urgent">Urgent</string>
    <string name="tasks_section_soon">Soon</string>
    <string name="tasks_section_calm">Calm</string>
    <!-- Distinct from tasks_empty above: there ARE tasks, just none matching the current filter
