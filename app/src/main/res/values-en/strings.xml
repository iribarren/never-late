    <string name="task_edit_save_button">Save</string>
    <string name="task_edit_delete_button">Delete task</string>
    <string name="tasks_error_blank_title">The title can\'t be empty.</string>
    <string name="tasks_error_invalid_duration">Enter valid hours and minutes (the total duration must be greater than 0).</string>
    <string name="tasks_error_invalid_deadline_format">The deadline must use the format dd/MM/yyyy HH:mm.</string>
    <string name="tasks_error_missing_duration_or_deadline">Enter an estimated duration or a deadline.</string>

    <!-- Pending tasks home-screen widget -->
    <string name="widget_pending_tasks_title">Pending tasks</string>
    <string name="widget_pending_tasks_empty">You have no pending tasks.</string>
    <string name="widget_pending_tasks_description">Shows your pending tasks and the time left on each.</string>
    <!-- Large-bucket row (widget-adaptive-layout): the row is tappable to complete the task, so
         its contentDescription names the action, not just the data (%1$s = title, remaining time
         and priority, already joined). -->
    <string name="widget_row_complete_content_description">Complete: %1$s</string>
    <!-- Feature 05b, renamed by priority-sorting (D8): priority marker glyphs, a repetition-count
         cue (not just color) leading a row's title. No longer widget-specific — the task card and
         the notification (feature priority-sorting) read the same three strings, via the single
         shared Priority.markerRes() mapping (ui/tasks/PriorityUi.kt). String resources rather than
         literals so a locale that reads "!!!" differently can change them without touching Kotlin. -->
    <string name="priority_marker_low">!</string>
    <string name="priority_marker_medium">!!</string>
    <string name="priority_marker_high">!!!</string>
    <!-- Feature 05b: sample task titles shown in the widget-picker preview (res/layout/widget_preview.xml,
         res/drawable/widget_preview_image.xml) — illustrative only, never read from a real task. -->
    <string name="widget_preview_task_first">Send report</string>
    <string name="widget_preview_task_second">Prepare meeting</string>
    <!-- Sample countdowns for that same preview. Resources rather than literals for the same reason
         as the titles: the live widget builds these through formatRemainingLabel, whose unit
         abbreviations are themselves localizable (feature 20b), so a locale that abbreviates
         minutes differently must be able to fix the preview without touching XML in values/. -->
    <string name="widget_preview_remaining_first">4m</string>
    <string name="widget_preview_remaining_second">48m</string>

    <!-- Lock-screen notification (feature 06) -->
    <string name="notification_channel_name">Pending tasks</string>
    <string name="notification_channel_description">Ongoing notification with your pending tasks and their remaining time.</string>
    <string name="notification_title">Pending tasks</string>
    <!-- Collapsed line: most urgent task title + its remaining time, e.g. "Call the doctor · 12:30". -->
    <string name="notification_content_text_format">%1$s · %2$s</string>
    <!-- One expanded InboxStyle row: task title + remaining time. -->
    <string name="notification_row_format">%1$s · %2$s</string>
    <!-- Feature priority-sorting (D7): same row, plus a trailing compact priority marker
         (!/!!/!!!), used ONLY for a non-NONE-priority task — a NONE-priority row keeps using
         notification_row_format above, unchanged. The marker is placed LAST so system truncation
         eats it before it ever eats the title or the remaining time. -->
    <string name="notification_row_format_priority">%1$s — %2$s %3$s</string>
    <!-- Redacted public (lock-screen) summary: count + most urgent remaining time, no titles. -->
    <plurals name="notification_public_summary">
        <item quantity="one">%1$d pending task · next in %2$s</item>
        <item quantity="other">%1$d pending tasks · next in %2$s</item>
    </plurals>

    <!-- Task reminders (feature 09): the alerting channel, separate from tasks_pending above. -->
    <string name="reminder_channel_name">Task reminders</string>
    <string name="reminder_channel_description">A one-off alert before a task is due.</string>
    <!-- Reminder notification body: minutes remaining (plural) + formatted deadline instant, e.g.
         "Due in 10 minutes · 12/24/2026 8:30 PM". %1$d is the minute count, %2$s the deadline. -->
    <plurals name="reminder_notification_body">
        <item quantity="one">Due in %1$d minute · %2$s</item>
        <item quantity="other">Due in %1$d minutes · %2$s</item>
    </plurals>

