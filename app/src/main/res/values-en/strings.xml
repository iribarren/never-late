    <!-- Modo Foco / Focus Mode (docs/specs/2026-08-18-focus-mode.md): entry point + entry dialog.
         D8/US-6: the message deliberately avoids lockdown language — BackHandler only intercepts
         this app's own back gesture; Home/recents/the shade all keep working. -->
    <string name="focus_title">Focus Mode</string>
    <string name="focus_entry_content_description">Open Focus Mode</string>
    <string name="focus_entry_dialog_message">You\'ll see only your pending tasks, full screen. To leave, finish the tasks, slide a bar and type the code you choose now. The Home button and recents keep working the whole time: this does not lock the device.</string>
    <string name="focus_entry_dialog_code_label">Exit code (4 digits)</string>
    <string name="focus_entry_dialog_start_button">Start</string>
    <string name="focus_entry_dialog_cancel_button">Cancel</string>

    <!-- Focus Mode: top-bar session progress, e.g. "3 of 7 tasks" (AC-V1). A <plurals> so the
         denominator agrees grammatically. -->
    <plurals name="focus_progress_state_description">
        <item quantity="one">%1$d of %2$d task</item>
        <item quantity="other">%1$d of %2$d tasks</item>
    </plurals>

    <!-- Focus Mode: "nothing pending left" state (reuses MessageState) + the persistent bottom exit
