        <item quantity="one">Tasks done (%1$d of %2$d)</item>
        <item quantity="other">Tasks done (%1$d of %2$d)</item>
    </plurals>
    <string name="focus_exit_requirement_code">Code entered</string>
    <string name="focus_exit_requirement_slide">Slide to exit</string>

