    <string name="tasks_no_results">No tasks match your filter.</string>
    <string name="tasks_no_results_clear_filter">Clear filter</string>

    <!-- Task create/edit screen -->
    <string name="task_edit_title_create">New task</string>
    <string name="task_edit_title_edit">Edit task</string>
    <string name="task_edit_title_label">Title</string>
    <string name="task_edit_duration_label">Estimated duration</string>
    <string name="task_edit_duration_hours_label">Hours</string>
    <string name="task_edit_duration_minutes_label">Minutes</string>
    <string name="task_edit_deadline_label">Deadline</string>
